@page "/books"

@using BookManager.Blazor.Components.Elements

<h3>All Books</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning">
        @errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="ClearError"></button>
    </div>
}

<div class="mb-3">
    <input type="text"
           class="form-control"
           placeholder="Search by title, author or ISBN…"
           @bind="searchTerm"
           @bind:event="oninput" />
</div>

@if (books == null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div>
        @foreach (var book in FilteredBooks)
        {
            <BookCard Book="book"
                      OnBorrow="() => BorrowBook(book.Id)"
                      OnReturn="() => ReturnBook(book.Id)" />
        }
    </div>
}

